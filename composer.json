{
  "name": "mosaicora/wordpress",
  "description": "Automatic Mosaicora Open Graph images and guided per-page overrides for WordPress.",
  "type": "wordpress-plugin",
  "license": "Apache-2.0",
  "homepage": "https://mosaicora.io/integrations/wordpress",
  "support": {
    "issues": "https://github.com/Mosaicora/plugin-wordpress/issues",
    "source": "https://github.com/Mosaicora/plugin-wordpress"
  },
  "keywords": [
    "mosaicora",
    "open-graph",
    "og-image",
    "seo",
    "social-media",
    "wordpress"
  ],
  "require": {
    "php": "^8.1",
    "mosaicora/plugin-core-php": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "Mosaicora\\WordPress\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mosaicora\\WordPress\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php -l mosaicora.php && find src tests scripts -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "package": "php scripts/package.php",
    "release:check": "php scripts/verify-release.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "autoloader-suffix": "MosaicoraWordPress",
    "sort-packages": true
  }
}
